# =============================================================================
#  KALT / SS Commercial Refrigeration — environment contract
#
#  Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#  Every key here is read in exactly one place: src/lib/env.ts
#
#  Only DATABASE_URL is REQUIRED. Every integration below is optional and
#  degrades cleanly when absent:
#    - no QStash   -> the outbox still commits; the sweeper delivers it late
#    - no Telegram -> that channel deregisters; notify falls through to email
#    - no R2       -> media uploads are refused with a clear error, nothing else breaks
#  That is deliberate: a missing side-channel must never take down the lead path.
# =============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (Neon) --- REQUIRED --------------------------------------------
# Use the POOLED connection string (…-pooler.…) for serverless.
DATABASE_URL=

# Optional read replica. Seam 5 — set it and reads route here automatically.
DATABASE_URL_RO=

# --- Object storage: Cloudflare R2 over the S3 API (seam 2) ------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN origin the browser fetches media from, e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=

# --- Queue: Upstash QStash (seam 6) ------------------------------------------
QSTASH_TOKEN=
# Both signing keys are needed to verify inbound job callbacks. QStash rotates
# between them, so verification must accept either.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Cache + rate limiting: Upstash Redis (seam 9) ---------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notifications (seam 11) -------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="KALT <noreply@example.com>"
SALES_INBOX=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Sign in with Google -----------------------------------------------------
# Optional, and free — Google does not charge for OAuth sign-in. Set BOTH and a
# "Continue with Google" button appears on /login and /register; leave both
# empty and those pages are email-and-password only, with no dead button.
#
# To create them:
#   1. console.cloud.google.com -> APIs & Services -> OAuth consent screen
#      (External; add your own address as a test user while it is unpublished)
#   2. Credentials -> Create credentials -> OAuth client ID -> Web application
#   3. Authorised redirect URI — one per environment, spelled exactly:
#        http://localhost:3000/api/auth/google/callback
#        https://<your-domain>/api/auth/google/callback
#
# The redirect URI is built from APP_URL, so APP_URL must match the origin the
# browser is actually on, or Google answers redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Abuse defence -----------------------------------------------------------
TURNSTILE_SECRET_KEY=
# The browser half of the SAME control — both or neither. Shipping the secret
# alone makes the server demand a token no browser was told to produce, which
# rejects every enquiry. Cloudflare's always-passes TEST pair, for local work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# HMAC salt for IP hashing. DPDP: raw IPs are never stored. Min 16 chars.
# Generate: openssl rand -hex 32
LEAD_IP_HASH_SALT=

# --- Shared secrets for machine-to-machine routes ----------------------------
# Guards /api/cron/[job]. Generate: openssl rand -hex 32
CRON_SECRET=
# Guards /api/revalidate. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Escape hatch ------------------------------------------------------------
# Lets CI typecheck/build without credentials. Never set this in production.
SKIP_ENV_VALIDATION=false

# --- analytics (optional) ---------------------------------------------------
# A COOKIELESS tag only — Plausible, Umami, Fathom, Vercel Analytics. Leave
# both unset and no third-party script is loaded at all.
#
# A cookieless, non-fingerprinting tag needs no consent banner, which is why
# this site ships without one. Google Analytics would change that: it sets
# cookies, and it would oblige you to add a banner, a working reject path and
# a longer privacy notice.
#
#   NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#   NEXT_PUBLIC_ANALYTICS_DOMAIN=ssrefrigeration.example
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
