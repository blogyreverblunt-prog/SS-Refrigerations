   "id": "el-0234",
   "seed": 399267691,
   "versionNonce": 1902842003,
   "type": "text",
   "x": 14,
   "y": 3734.3500000000004,
   "width": 2372,
   "height": 53.25,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "R2 bucket and the AVIF derive pipeline \u00b7 lib/image-loader.ts \u00b7 QStash queue and the 15-minute sweeper schedule \u00b7 Upstash Redis \u00b7 WhatsApp Cloud API and the WhatsApp-first call to action \u00b7 Resend \u00b7 Telegram \u00b7 Turnstile widget \u00b7 synthetic lead probe \u00b7 nightly pg_dump \u00b7 /admin and Auth.js \u00b7 careers, news, installations \u00b7 search UI \u00b7 Debezium, Kafka,\nOpenSearch, read replica, PgBouncer, multi-AZ.\nThey are not errors in those documents \u2014 they are the plan. They are omitted here so that this canvas can be trusted as a description of the running system. Status table: HLD-FREE-TIER.md \u00a70a.",
   "originalText": "R2 bucket and the AVIF derive pipeline \u00b7 lib/image-loader.ts \u00b7 QStash queue and the 15-minute sweeper schedule \u00b7 Upstash Redis \u00b7 WhatsApp Cloud API and the WhatsApp-first call to action \u00b7 Resend \u00b7 Telegram \u00b7 Turnstile widget \u00b7 synthetic lead probe \u00b7 nightly pg_dump \u00b7 /admin and Auth.js \u00b7 careers, news, installations \u00b7 search UI \u00b7 Debezium, Kafka,\nOpenSearch, read replica, PgBouncer, multi-AZ.\nThey are not errors in those documents \u2014 they are the plan. They are omitted here so that this canvas can be trusted as a description of the running system. Status table: HLD-FREE-TIER.md \u00a70a.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
