   "id": "el-0235",
   "seed": 1250763188,
   "versionNonce": 1805358749,
   "type": "text",
   "x": 0,
   "y": 3831.6000000000004,
   "width": 2400,
   "height": 36.4,
   "strokeColor": "#6c757d",
   "backgroundColor": "transparent",
   "fontSize": 13,
   "fontFamily": 2,
   "text": "Legend: green = built, configured and verified \u00b7 amber = built but degraded, or a limit worth watching \u00b7 red = broken, missing, or non-compliant \u00b7 grey = present in code but unconfigured, so inert \u00b7 teal = built and serving (render tier, modules) \u00b7 blue = the visitor \u00b7 yellow-edge = host and CDN. Every claim on this canvas was checked\nagainst the live deployment on 2026-10-12 \u2014 see the docstring in _src/gen_current.py for the exact commands. Faults and fixes: docs/ops/REMEDIATION-PLAN.md",
   "originalText": "Legend: green = built, configured and verified \u00b7 amber = built but degraded, or a limit worth watching \u00b7 red = broken, missing, or non-compliant \u00b7 grey = present in code but unconfigured, so inert \u00b7 teal = built and serving (render tier, modules) \u00b7 blue = the visitor \u00b7 yellow-edge = host and CDN. Every claim on this canvas was checked\nagainst the live deployment on 2026-10-12 \u2014 see the docstring in _src/gen_current.py for the exact commands. Faults and fixes: docs/ops/REMEDIATION-PLAN.md",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.4,
   "autoResize": false,
   "baseline": 10.4
  }
