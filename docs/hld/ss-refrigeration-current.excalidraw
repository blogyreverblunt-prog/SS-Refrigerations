   "id": "el-0004",
   "seed": 2130544070,
   "versionNonce": 1117153375,
   "type": "text",
   "x": 14,
   "y": 170.12,
   "width": 2372,
   "height": 23.18,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 19,
   "fontFamily": 2,
   "text": "THE SITE RENDERS CORRECTLY AND CAPTURES NOTHING.  Lead capture is the only revenue path, and it is closed.",
   "originalText": "THE SITE RENDERS CORRECTLY AND CAPTURES NOTHING.  Lead capture is the only revenue path, and it is closed.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 15.200000000000001
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
