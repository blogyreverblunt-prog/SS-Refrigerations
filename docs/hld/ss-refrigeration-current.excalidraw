   "id": "el-0005",
   "seed": 551942410,
   "versionNonce": 1754975484,
   "type": "text",
   "x": 14,
   "y": 201.3,
   "width": 2372,
   "height": 36.92,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 13,
   "fontFamily": 2,
   "text": "POST /api/leads returns 400 captcha_failed on every request. lib/adapters/captcha.ts fails closed in production, which is correct on its own \u2014 but no Turnstile widget exists in any component, so no request can carry a token. Setting TURNSTILE_SECRET_KEY does not fix it; that only changes the error to \"Missing verification token\".\nEverything that builds, renders and deploys is green. 22 routes, 18 passing browser checks, no console error, no failed request. Every one of those checks tested rendering. None submitted the form.",
   "originalText": "POST /api/leads returns 400 captcha_failed on every request. lib/adapters/captcha.ts fails closed in production, which is correct on its own \u2014 but no Turnstile widget exists in any component, so no request can carry a token. Setting TURNSTILE_SECRET_KEY does not fix it; that only changes the error to \"Missing verification token\".\nEverything that builds, renders and deploys is green. 22 routes, 18 passing browser checks, no console error, no failed request. Every one of those checks tested rendering. None submitted the form.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.4
  },
