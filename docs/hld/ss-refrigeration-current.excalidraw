   "backgroundColor": "transparent",
   "fontSize": 34,
   "fontFamily": 2,
   "text": "As-Built  \u00b7  Production  \u00b7  2026-10-12",
   "originalText": "As-Built  \u00b7  Production  \u00b7  2026-10-12",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.18,
   "autoResize": false,
   "baseline": 27.200000000000003
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
