   "id": "el-0097",
   "seed": 1520517991,
   "versionNonce": 210365973,
   "type": "text",
   "x": 2219.0,
   "y": 2423.3699999999994,
   "width": 687.0,
   "height": 179.63,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 11.5,
   "fontFamily": 3,
   "text": "No cart. No checkout. No payment gateway.\nNo \"build & price\" configurator \u2014 the current\nindex.html has that CTA and the report says cut\nit, because 0 of 5 publish a price to configure\nagainst.\nNo per-dealer discount engine in v1.\n\nA price that is WRONG is worse than no price: it\nis the one piece of content on a refrigeration\nsite that a customer will quote back at you, six\nmonths later, in a negotiation.",
   "originalText": "No cart. No checkout. No payment gateway.\nNo \"build & price\" configurator \u2014 the current\nindex.html has that CTA and the report says cut\nit, because 0 of 5 publish a price to configure\nagainst.\nNo per-dealer discount engine in v1.\n\nA price that is WRONG is worse than no price: it\nis the one piece of content on a refrigeration\nsite that a customer will quote back at you, six\nmonths later, in a negotiation.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 9.200000000000001
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
