   "id": "el-0135",
   "seed": 731899792,
   "versionNonce": 1843690166,
   "type": "text",
   "x": 14,
   "y": 3681.63,
   "width": 2892,
   "height": 19.52,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Why the free tier costs you latency, not safety",
   "originalText": "Why the free tier costs you latency, not safety",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.8
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0136",
   "seed": 1033950666,
   "versionNonce": 1764131376,
   "type": "text",
   "x": 14,
   "y": 3709.15,
   "width": 2892,
   "height": 36.92,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 13,
   "fontFamily": 2,
   "text": "The commit at step 2 is the durability boundary, exactly as in HLD.md. Steps 4-6 are best-effort delivery on top of a row that is already committed. QStash can be down, over quota or slow: the lead is not lost, it is late, and step 7 collects it. What the free tier costs is the worst-case notification latency \u2014 seconds becomes at most 15 minutes. What it does not cost is a dropped enquiry, and one lost\nRFQ is worth more than a year of hosting.",
   "originalText": "The commit at step 2 is the durability boundary, exactly as in HLD.md. Steps 4-6 are best-effort delivery on top of a row that is already committed. QStash can be down, over quota or slow: the lead is not lost, it is late, and step 7 collects it. What the free tier costs is the worst-case notification latency \u2014 seconds becomes at most 15 minutes. What it does not cost is a dropped enquiry, and one lost\nRFQ is worth more than a year of hosting.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0137",
   "seed": 1522244299,
   "versionNonce": 2100287387,
   "type": "text",
   "x": 0,
   "y": 3820.07,
   "width": 2920,
   "height": 28.799999999999997,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 24,
   "fontFamily": 2,
   "text": "7 \u00b7 What it costs to serve all of that \u2014 the $0 topology",
   "originalText": "7 \u00b7 What it costs to serve all of that \u2014 the $0 topology",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.2,
   "autoResize": false,
   "baseline": 19.200000000000003
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
