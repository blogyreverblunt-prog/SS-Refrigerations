   "id": "el-0007",
   "seed": 1346777778,
   "versionNonce": 1571185158,
   "type": "text",
   "x": 14,
   "y": 246.22,
   "width": 2892,
   "height": 18.3,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 15,
   "fontFamily": 2,
   "text": "Hosting constraint, unchanged from Rev 1.0 \u2014 Vercel Hobby forbids commercial use.  Design on it, do not launch on it.",
   "originalText": "Hosting constraint, unchanged from Rev 1.0 \u2014 Vercel Hobby forbids commercial use.  Design on it, do not launch on it.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
