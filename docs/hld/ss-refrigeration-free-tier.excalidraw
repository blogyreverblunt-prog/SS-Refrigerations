   "seed": 837586459,
   "versionNonce": 1551088034,
   "type": "text",
   "x": 0,
   "y": 3854.8700000000003,
   "width": 2920,
   "height": 19.599999999999998,
   "strokeColor": "#6c757d",
   "backgroundColor": "transparent",
   "fontSize": 14,
   "fontFamily": 2,
   "text": "The feature set above maps onto four render modes and three stores. Quotas on every box, verified from each provider's own pricing page on 2026-10-07. Ledger down the right.",
   "originalText": "The feature set above maps onto four render modes and three stores. Quotas on every box, verified from each provider's own pricing page on 2026-10-07. Ledger down the right.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.4,
   "autoResize": false,
   "baseline": 11.200000000000001
  },
