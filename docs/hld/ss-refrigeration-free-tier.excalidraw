   "versionNonce": 12621309,
   "type": "text",
   "x": 0,
   "y": 416.82,
   "width": 2920,
   "height": 19.599999999999998,
   "strokeColor": "#6c757d",
   "backgroundColor": "transparent",
   "fontSize": 14,
   "fontFamily": 2,
   "text": "Every card carries its convergence count from the audit (how many of the five sites have it), its render strategy, and what it reads or writes. 5/5 is table stakes; a section at 1/5 is one company's pet project.",
