   "id": "el-0008",
   "seed": 151507924,
   "versionNonce": 1642608884,
   "type": "text",
   "x": 14,
   "y": 272.52,
   "width": 2892,
   "height": 35.5,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "Vercel Fair Use Guidelines, verbatim: \"Hobby teams are restricted to non-commercial personal use only.\" A client's B2B lead-generation site is commercial use. Launch on Vercel Pro ($20/mo, no code change) or Cloudflare Workers ($0, commercially permitted, add @opennextjs/cloudflare \u2014 one day, once). Everything below is host-agnostic Next.js with no Vercel-proprietary API on a critical path, specifically so that stays a\none-day change.",
   "originalText": "Vercel Fair Use Guidelines, verbatim: \"Hobby teams are restricted to non-commercial personal use only.\" A client's B2B lead-generation site is commercial use. Launch on Vercel Pro ($20/mo, no code change) or Cloudflare Workers ($0, commercially permitted, add @opennextjs/cloudflare \u2014 one day, once). Everything below is host-agnostic Next.js with no Vercel-proprietary API on a critical path, specifically so that stays a\none-day change.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
