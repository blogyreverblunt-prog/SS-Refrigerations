   "id": "el-0090",
   "seed": 755222594,
   "versionNonce": 216373473,
   "type": "text",
   "x": 749.0,
   "y": 2396.4599999999996,
   "width": 687.0,
   "height": 18.91,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 15.5,
   "fontFamily": 2,
   "text": "The three shapes it can take \u2014 decide BEFORE building",
   "originalText": "The three shapes it can take \u2014 decide BEFORE building",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0091",
   "seed": 1951971904,
   "versionNonce": 1337755070,
   "type": "text",
   "x": 749.0,
   "y": 2423.3699999999994,
   "width": 687.0,
   "height": 195.95999999999998,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 11.5,
   "fontFamily": 3,
   "text": "A  INDICATIVE    \"from Rs 1,25,000 + GST\" per model\n                 family. Cheapest to run, filters out\n                 tyre-kickers, costs negotiating room.\nB  LIST / MRP    full price + \"GST extra, freight extra,\n                 installation quoted separately\". Needs a\n                 real price-revision process behind it.\nC  DEALER-ONLY   visible after login, by dealer tier. Most\n                 flexible, most to build \u2014 needs the user\n                 accounts v1 deliberately does not have.\n\nThese are not the same schema. A is a string on a family,\nC is a join table and an auth boundary.",
   "originalText": "A  INDICATIVE    \"from Rs 1,25,000 + GST\" per model\n                 family. Cheapest to run, filters out\n                 tyre-kickers, costs negotiating room.\nB  LIST / MRP    full price + \"GST extra, freight extra,\n                 installation quoted separately\". Needs a\n                 real price-revision process behind it.\nC  DEALER-ONLY   visible after login, by dealer tier. Most\n                 flexible, most to build \u2014 needs the user\n                 accounts v1 deliberately does not have.\n\nThese are not the same schema. A is a string on a family,\nC is a join table and an auth boundary.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 9.200000000000001
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
