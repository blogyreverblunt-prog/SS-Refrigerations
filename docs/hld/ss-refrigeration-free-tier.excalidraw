   "seed": 1805972219,
   "versionNonce": 884088695,
   "type": "text",
   "x": 1554,
   "y": 1683.7499999999998,
   "width": 1352,
   "height": 261.28,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 11.5,
   "fontFamily": 3,
   "text": "THE 11 ROWS BEVERAGE-AIR SHIPS   (CT2HC-1S, verbatim)\n  model number \u00b7 exterior dimensions W x D x H \u00b7 interior\n  dimensions \u00b7 exterior construction \u00b7 interior construction\n  \u00b7 doors \u00b7 shelves \u00b7 net capacity \u00b7 hinge location \u00b7\n  compressor location \u00b7 door type\n\nADD FIVE FOR INDIA\n  voltage / frequency / phase    230 V 1-ph or 415 V 3-ph, 50 Hz\n  power consumption              W\n  ambient / climate class        rated for Indian summer\n  net and gross weight           kg\n  energy rating                  star label where applicable\n\nUNITS: METRIC FIRST. Litres and mm primary, cu ft and inches\nsecondary. This is the single most common localisation failure\nwhen copying the structure of a US site.",
   "originalText": "THE 11 ROWS BEVERAGE-AIR SHIPS   (CT2HC-1S, verbatim)\n  model number \u00b7 exterior dimensions W x D x H \u00b7 interior\n  dimensions \u00b7 exterior construction \u00b7 interior construction\n  \u00b7 doors \u00b7 shelves \u00b7 net capacity \u00b7 hinge location \u00b7\n  compressor location \u00b7 door type\n\nADD FIVE FOR INDIA\n  voltage / frequency / phase    230 V 1-ph or 415 V 3-ph, 50 Hz\n  power consumption              W\n  ambient / climate class        rated for Indian summer\n  net and gross weight           kg\n  energy rating                  star label where applicable\n\nUNITS: METRIC FIRST. Litres and mm primary, cu ft and inches\nsecondary. This is the single most common localisation failure\nwhen copying the structure of a US site.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 9.200000000000001
  },
