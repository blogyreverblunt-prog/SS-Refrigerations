   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 15.5,
   "fontFamily": 2,
   "text": "What NOT to build",
   "originalText": "What NOT to build",
   "textAlign": "left",
   "verticalAlign": "top",
