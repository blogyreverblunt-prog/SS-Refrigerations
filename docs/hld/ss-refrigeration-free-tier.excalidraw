   "seed": 1110592410,
   "versionNonce": 1275503363,
   "type": "text",
   "x": 14.0,
   "y": 2423.3699999999994,
   "width": 687.0,
   "height": 195.95999999999998,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 11.5,
   "fontFamily": 3,
   "text": "Western \u00b7 True \u00b7 Beverage-Air \u00b7 Traulsen \u00b7\nBlue Star\n   prices published:   0 of 5\n\nEvery path on all five ends in \"request a\nquote\" or \"find a dealer\".\n\nA commercial cabinet price is a function of\nconfiguration, quantity, dealer margin, GST,\nfreight and installation. Publishing one\nnumber invites a dispute you then defend on\nevery single enquiry.",
   "originalText": "Western \u00b7 True \u00b7 Beverage-Air \u00b7 Traulsen \u00b7\nBlue Star\n   prices published:   0 of 5\n\nEvery path on all five ends in \"request a\nquote\" or \"find a dealer\".\n\nA commercial cabinet price is a function of\nconfiguration, quantity, dealer margin, GST,\nfreight and installation. Publishing one\nnumber invites a dispute you then defend on\nevery single enquiry.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 9.200000000000001
