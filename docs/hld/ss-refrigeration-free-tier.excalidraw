   "height": 28.799999999999997,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 24,
   "fontFamily": 2,
   "text": "5 \u00b7 Faceted filter specification \u2014 one facet set, metric first",
   "originalText": "5 \u00b7 Faceted filter specification \u2014 one facet set, metric first",
