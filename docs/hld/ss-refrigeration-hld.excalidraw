   "backgroundColor": "transparent",
   "fontSize": 18,
   "fontFamily": 2,
   "text": "Phase 3 \u2014 >1M MAU / dealer portal / IoT",
   "originalText": "Phase 3 \u2014 >1M MAU / dealer portal / IoT",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 14.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0328",
   "seed": 732440021,
   "versionNonce": 683165220,
   "type": "text",
   "x": 2222.75,
   "y": 4960.790000000001,
   "width": 683.25,
   "height": 230.75,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "Extract only the seams that hurt, in\norder: Search, Media, Notification \u2014\nbursty, independently scaled, clean\ncontracts already. Kafka replaces SQS.\n\nMulti-region: single writer region +\nregional read replicas + regional ISR.\nTimescale for cabinet telemetry,\npgvector for the AI spec assistant.\n\nTRIGGERS, not dates: p95 primary CPU\n>60%, deploy lead time >1 day, or two\nteams blocked on one repository.",
   "originalText": "Extract only the seams that hurt, in\norder: Search, Media, Notification \u2014\nbursty, independently scaled, clean\ncontracts already. Kafka replaces SQS.\n\nMulti-region: single writer region +\nregional read replicas + regional ISR.\nTimescale for cabinet telemetry,\npgvector for the AI spec assistant.\n\nTRIGGERS, not dates: p95 primary CPU\n>60%, deploy lead time >1 day, or two\nteams blocked on one repository.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
