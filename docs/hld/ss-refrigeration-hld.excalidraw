   "seed": 1863465668,
   "versionNonce": 104915550,
   "type": "text",
   "x": 1234.0,
   "y": 4140.280000000001,
   "width": 812.0,
   "height": 19.52,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "MongoDB \u2014 rejected",
   "originalText": "MongoDB \u2014 rejected",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.8
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0299",
   "seed": 1584036649,
   "versionNonce": 1438092122,
   "type": "text",
   "x": 1234.0,
   "y": 4167.800000000001,
   "width": 812.0,
   "height": 88.75,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "The catalogue is a graph with integrity rules, not a pile of documents. Orphaned variants and dangling asset references\nare the number-one CMS bug class and Mongo cannot express the constraint that prevents them. $lookup is weak and slow\nfor the faceted admin queries this team runs daily, and multi-document transactions remain a bolt-on. Its one genuine\nadvantage \u2014 schemaless specs \u2014 is already covered by JSONB + GIN with joins left intact. Choosing it here means\nhand-rolling referential integrity in application code forever.",
   "originalText": "The catalogue is a graph with integrity rules, not a pile of documents. Orphaned variants and dangling asset references\nare the number-one CMS bug class and Mongo cannot express the constraint that prevents them. $lookup is weak and slow\nfor the faceted admin queries this team runs daily, and multi-document transactions remain a bolt-on. Its one genuine\nadvantage \u2014 schemaless specs \u2014 is already covered by JSONB + GIN with joins left intact. Choosing it here means\nhand-rolling referential integrity in application code forever.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
