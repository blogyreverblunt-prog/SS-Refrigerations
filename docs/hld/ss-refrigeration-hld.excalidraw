   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0187",
   "seed": 2072268775,
   "versionNonce": 1375699451,
   "type": "text",
   "x": 0,
   "y": 2162.5600000000004,
   "width": 2920,
   "height": 19.599999999999998,
   "strokeColor": "#6c757d",
   "backgroundColor": "transparent",
   "fontSize": 14,
   "fontFamily": 2,
   "text": "Everything else on this page can degrade. These two define the business.",
   "originalText": "Everything else on this page can degrade. These two define the business.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.4,
   "autoResize": false,
   "baseline": 11.200000000000001
  },
  {
   "isDeleted": false,
