   "height": 28.799999999999997,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 24,
   "fontFamily": 2,
   "text": "3 \u00b7 Data model \u2014 one PostgreSQL instance, five bounded contexts",
   "originalText": "3 \u00b7 Data model \u2014 one PostgreSQL instance, five bounded contexts",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.2,
   "autoResize": false,
   "baseline": 19.200000000000003
  },
  {
   "isDeleted": false,
