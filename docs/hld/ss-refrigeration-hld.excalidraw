   "id": "el-0334",
   "seed": 148989758,
   "versionNonce": 954855377,
   "type": "text",
   "x": 994.0,
   "y": 5415.630000000001,
   "width": 932.0,
   "height": 21.96,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 18,
   "fontFamily": 2,
   "text": "SLOs and the performance budget",
   "originalText": "SLOs and the performance budget",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 14.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0335",
   "seed": 51102235,
   "versionNonce": 560741276,
   "type": "text",
   "x": 994.0,
   "y": 5445.590000000001,
   "width": 932.0,
   "height": 390.5,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "AVAILABILITY   site 99.9%  \u00b7  POST /v1/leads 99.95%\n               the lead endpoint gets the tighter target because it is\n               the only revenue-carrying write in the system.\n\nLATENCY        TTFB p75 < 400 ms   \u00b7   internal API p99 < 300 ms\n\nWEB VITALS     LCP p75 < 2.0 s  \u00b7  INP < 200 ms  \u00b7  CLS < 0.1\n               enforced by Lighthouse CI budgets \u2014 a regression fails\n               the build rather than quietly shipping. CWV is a Google\n               ranking input, so this is an SEO control, not polish.\n\nDURABILITY     RPO 5 min (WAL ship)  \u00b7  RTO 30 min, drilled quarterly\n               leads: zero tolerance -> outbox + DLQ + alert on depth > 0\n\nFRESHNESS      publish -> live p95 < 30 s  \u00b7  index lag p95 < 60 s\n\nA11Y / SEO     WCAG 2.2 AA with axe clean in CI \u00b7 schema.org Product,\n               Organization, BreadcrumbList \u00b7 sitemap per locale \u00b7\n               301 map maintained on every information-architecture change\n\nERROR BUDGET   0.1%/month ~ 43 min. Budget exhausted -> feature freeze\n               and the next sprint is reliability work. Not negotiable.",
   "originalText": "AVAILABILITY   site 99.9%  \u00b7  POST /v1/leads 99.95%\n               the lead endpoint gets the tighter target because it is\n               the only revenue-carrying write in the system.\n\nLATENCY        TTFB p75 < 400 ms   \u00b7   internal API p99 < 300 ms\n\nWEB VITALS     LCP p75 < 2.0 s  \u00b7  INP < 200 ms  \u00b7  CLS < 0.1\n               enforced by Lighthouse CI budgets \u2014 a regression fails\n               the build rather than quietly shipping. CWV is a Google\n               ranking input, so this is an SEO control, not polish.\n\nDURABILITY     RPO 5 min (WAL ship)  \u00b7  RTO 30 min, drilled quarterly\n               leads: zero tolerance -> outbox + DLQ + alert on depth > 0\n\nFRESHNESS      publish -> live p95 < 30 s  \u00b7  index lag p95 < 60 s\n\nA11Y / SEO     WCAG 2.2 AA with axe clean in CI \u00b7 schema.org Product,\n               Organization, BreadcrumbList \u00b7 sitemap per locale \u00b7\n               301 map maintained on every information-architecture change\n\nERROR BUDGET   0.1%/month ~ 43 min. Budget exhausted -> feature freeze\n               and the next sprint is reliability work. Not negotiable.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
