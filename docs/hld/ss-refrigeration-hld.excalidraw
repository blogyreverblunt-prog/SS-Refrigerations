   "id": "el-0318",
   "seed": 1789262849,
   "versionNonce": 1110902004,
   "type": "text",
   "x": 14.0,
   "y": 4930.830000000001,
   "width": 683.25,
   "height": 21.96,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 18,
   "fontFamily": 2,
   "text": "Phase 0 \u2014 today",
   "originalText": "Phase 0 \u2014 today",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 14.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0319",
   "seed": 1267224368,
   "versionNonce": 1865326510,
   "type": "text",
   "x": 14.0,
   "y": 4960.790000000001,
   "width": 683.25,
   "height": 177.5,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "Hand-written HTML + CSS on a CDN.\nZero servers, effectively zero cost.\n\nHOLDS: a handful of pages, content\nchanged by a developer in git.\n\nBREAKS WHEN: a non-developer has to\npublish, or SKUs pass roughly 30, or\nthe same spec appears on 4 pages and\nthey start to disagree with each other.",
   "originalText": "Hand-written HTML + CSS on a CDN.\nZero servers, effectively zero cost.\n\nHOLDS: a handful of pages, content\nchanged by a developer in git.\n\nBREAKS WHEN: a non-developer has to\npublish, or SKUs pass roughly 30, or\nthe same spec appears on 4 pages and\nthey start to disagree with each other.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0320",
   "seed": 857798686,
   "versionNonce": 1512838047,
   "type": "rectangle",
   "x": 736.25,
   "y": 4916.830000000001,
   "width": 711.25,
   "height": 360,
   "strokeColor": "#2b8a3e",
   "backgroundColor": "#d3f9d8",
   "roundness": {
    "type": 3
   }
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
