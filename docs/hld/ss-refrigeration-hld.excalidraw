   "locked": false,
   "version": 1,
   "id": "el-0310",
   "seed": 1316441051,
   "versionNonce": 881733262,
   "type": "text",
   "x": 1234.0,
   "y": 4580.280000000001,
   "width": 812.0,
   "height": 19.52,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Elasticsearch / OpenSearch as the primary store \u2014 rejected",
   "originalText": "Elasticsearch / OpenSearch as the primary store \u2014 rejected",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.8
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0311",
   "seed": 1803618979,
   "versionNonce": 407544747,
   "type": "text",
   "x": 1234.0,
   "y": 4607.800000000001,
   "width": 812.0,
   "height": 53.25,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "No transactions, no foreign keys, painful and lossy on mapping changes, and a reindex bug becomes permanent data loss\nrather than a cache miss. Its correct role is a derived, disposable index fed by CDC \u2014 which is exactly how it appears\nin layer 6. The same reasoning excludes Redis-as-database.",
   "originalText": "No transactions, no foreign keys, painful and lossy on mapping changes, and a reindex bug becomes permanent data loss\nrather than a cache miss. Its correct role is a derived, disposable index fed by CDC \u2014 which is exactly how it appears\nin layer 6. The same reasoning excludes Redis-as-database.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0312",
   "seed": 1769144393,
   "versionNonce": 2112183920,
   "type": "rectangle",
   "x": 2080.0,
   "y": 4566.280000000001,
   "width": 840.0,
   "height": 200,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff3bf",
   "roundness": {
    "type": 3
   }
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0313",
   "seed": 1670443569,
   "versionNonce": 917778474,
   "type": "text",
   "x": 2094.0,
   "y": 4580.280000000001,
   "width": 812.0,
   "height": 19.52,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Headless SaaS CMS alone (Contentful / Sanity) \u2014 partially adopted",
   "originalText": "Headless SaaS CMS alone (Contentful / Sanity) \u2014 partially adopted",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.8
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0314",
   "seed": 1753102735,
   "versionNonce": 1083851742,
   "type": "text",
   "x": 2094.0,
   "y": 4607.800000000001,
   "width": 812.0,
   "height": 71.0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "Superb editor experience for pages and news, and worth paying for. But product specs, RFQ leads and CV applications\nneed our own transactional store, real joins and our own retention and erasure controls \u2014 and per-record SaaS pricing\nacross 350 SKUs x N locales is poor value. Chosen middle path: Payload or Strapi running on OUR Postgres. One schema,\none backup, one restore drill, and the editors still get a good CMS.",
   "originalText": "Superb editor experience for pages and news, and worth paying for. But product specs, RFQ leads and CV applications\nneed our own transactional store, real joins and our own retention and erasure controls \u2014 and per-record SaaS pricing\nacross 350 SKUs x N locales is poor value. Chosen middle path: Payload or Strapi running on OUR Postgres. One schema,\none backup, one restore drill, and the editors still get a good CMS.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0315",
   "seed": 1938303922,
   "versionNonce": 938242558,
   "type": "text",
   "x": 0,
   "y": 4842.43,
   "width": 2920,
   "height": 28.799999999999997,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 24,
   "fontFamily": 2,
   "text": "5 \u00b7 Scaling path \u2014 buy the next 10x, not the next 1000x",
   "originalText": "5 \u00b7 Scaling path \u2014 buy the next 10x, not the next 1000x",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.2,
   "autoResize": false,
   "baseline": 19.200000000000003
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0316",
   "seed": 1299482029,
   "versionNonce": 968291743,
   "type": "text",
   "x": 0,
   "y": 4877.2300000000005,
   "width": 2920,
   "height": 19.599999999999998,
   "strokeColor": "#6c757d",
   "backgroundColor": "transparent",
   "fontSize": 14,
   "fontFamily": 2,
   "text": "Each phase is triggered by a metric, never by a calendar date. Premature distribution is the most expensive mistake available here.",
   "originalText": "Each phase is triggered by a metric, never by a calendar date. Premature distribution is the most expensive mistake available here.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.4,
   "autoResize": false,
   "baseline": 11.200000000000001
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
