   "seed": 994449196,
   "versionNonce": 1050333162,
   "type": "text",
   "x": 1486.5,
   "y": 4960.790000000001,
   "width": 683.25,
   "height": 230.75,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "ADD: 2 read replicas + PgBouncer \u00b7\nRedis \u00b7 OpenSearch + CDC indexer \u00b7\nSQS + autoscaled workers \u00b7 image CDN \u00b7\ni18n + hreflang \u00b7 CRM sync \u00b7\nClickHouse for lead attribution.\n\nStill ONE codebase; the services in\nlayer 5 stay modules behind interfaces.\n\nCapacity check: a 40 rps expo spike\nis one replica and a warm cache. The\nwork here is correctness and freshness,\nnot throughput.",
   "originalText": "ADD: 2 read replicas + PgBouncer \u00b7\nRedis \u00b7 OpenSearch + CDC indexer \u00b7\nSQS + autoscaled workers \u00b7 image CDN \u00b7\ni18n + hreflang \u00b7 CRM sync \u00b7\nClickHouse for lead attribution.\n\nStill ONE codebase; the services in\nlayer 5 stay modules behind interfaces.\n\nCapacity check: a 40 rps expo spike\nis one replica and a warm cache. The\nwork here is correctness and freshness,\nnot throughput.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
