   "version": 1,
   "id": "el-0307",
   "seed": 1437865792,
   "versionNonce": 1692559539,
   "type": "text",
   "x": 2094.0,
   "y": 4360.280000000001,
   "width": 812.0,
   "height": 19.52,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Firestore / Airtable / Sheets as the backend \u2014 rejected",
   "originalText": "Firestore / Airtable / Sheets as the backend \u2014 rejected",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 12.8
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0308",
   "seed": 256830899,
   "versionNonce": 758254366,
   "type": "text",
   "x": 2094.0,
   "y": 4387.800000000001,
   "width": 812.0,
   "height": 71.0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "Firestore: weak ad-hoc querying, per-read billing that punishes a crawler walking the catalogue, no SQL for BI, heavy\nlock-in. Airtable or Sheets is genuinely tempting at 350 SKUs and will work for a quarter, then deliver no\ntransactions, no referential integrity, hard API rate limits and no migration path. Supabase is fine \u2014 but it *is*\nPostgres, so that is a hosting decision, not a database decision.",
   "originalText": "Firestore: weak ad-hoc querying, per-read billing that punishes a crawler walking the catalogue, no SQL for BI, heavy\nlock-in. Airtable or Sheets is genuinely tempting at 350 SKUs and will work for a quarter, then deliver no\ntransactions, no referential integrity, hard API rate limits and no migration path. Supabase is fine \u2014 but it *is*\nPostgres, so that is a hosting decision, not a database decision.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0309",
   "seed": 1594954961,
   "versionNonce": 1479139459,
   "type": "rectangle",
   "x": 1220.0,
   "y": 4566.280000000001,
   "width": 840.0,
   "height": 200,
   "strokeColor": "#c92a2a",
   "backgroundColor": "#ffe3e3",
   "roundness": {
    "type": 3
   }
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
