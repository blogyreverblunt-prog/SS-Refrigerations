   "version": 1,
   "id": "el-0321",
   "seed": 1739375155,
   "versionNonce": 510944434,
   "type": "text",
   "x": 750.25,
   "y": 4930.830000000001,
   "width": 683.25,
   "height": 21.96,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 18,
   "fontFamily": 2,
   "text": "Phase 1 \u2014 0 to 50k MAU  (Q1)",
   "originalText": "Phase 1 \u2014 0 to 50k MAU  (Q1)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 14.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0322",
   "seed": 1370023855,
   "versionNonce": 821407916,
   "type": "text",
   "x": 750.25,
   "y": 4960.790000000001,
   "width": 683.25,
   "height": 213.0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "Next.js on Vercel or Cloud Run.\nManaged Postgres, 2 vCPU / 8 GB.\nS3 + CDN. Resend for mail.\nPayload CMS on the SAME Postgres.\nModular monolith, one deploy unit.\n\nSearch = Postgres tsvector.\nQueue = outbox + a cron worker.\nNo Redis, no Kafka, no mesh.\n\nRoughly INR 15-25k/month. Two\nengineers can run it comfortably.",
   "originalText": "Next.js on Vercel or Cloud Run.\nManaged Postgres, 2 vCPU / 8 GB.\nS3 + CDN. Resend for mail.\nPayload CMS on the SAME Postgres.\nModular monolith, one deploy unit.\n\nSearch = Postgres tsvector.\nQueue = outbox + a cron worker.\nNo Redis, no Kafka, no mesh.\n\nRoughly INR 15-25k/month. Two\nengineers can run it comfortably.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
