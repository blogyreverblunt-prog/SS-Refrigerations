   "versionNonce": 1544651100,
   "type": "text",
   "x": 0,
   "y": 2127.76,
   "width": 2920,
   "height": 28.799999999999997,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 24,
   "fontFamily": 2,
   "text": "2 \u00b7 The two paths that must not break",
   "originalText": "2 \u00b7 The two paths that must not break",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.2,
   "autoResize": false,
   "baseline": 19.200000000000003
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
