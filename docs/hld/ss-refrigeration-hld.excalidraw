   "id": "el-0331",
   "seed": 1511911200,
   "versionNonce": 124358739,
   "type": "text",
   "x": 14.0,
   "y": 5415.630000000001,
   "width": 932.0,
   "height": 21.96,
   "strokeColor": "#1a1d23",
   "backgroundColor": "transparent",
   "fontSize": 18,
   "fontFamily": 2,
   "text": "Capacity \u2014 sized from reality, not vanity",
   "originalText": "Capacity \u2014 sized from reality, not vanity",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.22,
   "autoResize": false,
   "baseline": 14.4
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "id": "el-0332",
   "seed": 1012788026,
   "versionNonce": 182793066,
   "type": "text",
   "x": 14.0,
   "y": 5445.590000000001,
   "width": 932.0,
   "height": 301.75,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fontSize": 12.5,
   "fontFamily": 2,
   "text": "TRAFFIC  A B2B refrigeration brand in India lands around\n  150-300k pageviews/month  ->  about 0.1 rps average.\n  Trade-show or campaign peak: 20-40 rps for a couple of hours.\n  With 95%+ CDN offload the origin sees under 2 rps even at peak.\n  One small instance and one replica is genuinely enough.\n\nWRITES  30-80 leads/day, ~10 applications/day, ~20 publishes/week.\n  Hundreds of writes per day. A single primary is correct.\n\nSTORAGE  350 SKUs x (8 images x 300 KB + 2 PDFs x 3 MB) ~ 8 GB in S3.\n  Postgres stays under 2 GB, so the entire working set fits in RAM.\n  No sharding, ever, at this scale. Anyone proposing it is designing\n  for their promotion packet rather than for this business.\n\nTHE REAL BILL IS EGRESS  Images dominate cost and LCP alike. AVIF plus\n  exact-width srcset plus immutable long-cache cuts it by roughly 70%,\n  which is why the image CDN in layer 2 is not a nice-to-have.",
   "originalText": "TRAFFIC  A B2B refrigeration brand in India lands around\n  150-300k pageviews/month  ->  about 0.1 rps average.\n  Trade-show or campaign peak: 20-40 rps for a couple of hours.\n  With 95%+ CDN offload the origin sees under 2 rps even at peak.\n  One small instance and one replica is genuinely enough.\n\nWRITES  30-80 leads/day, ~10 applications/day, ~20 publishes/week.\n  Hundreds of writes per day. A single primary is correct.\n\nSTORAGE  350 SKUs x (8 images x 300 KB + 2 PDFs x 3 MB) ~ 8 GB in S3.\n  Postgres stays under 2 GB, so the entire working set fits in RAM.\n  No sharding, ever, at this scale. Anyone proposing it is designing\n  for their promotion packet rather than for this business.\n\nTHE REAL BILL IS EGRESS  Images dominate cost and LCP alike. AVIF plus\n  exact-width srcset plus immutable long-cache cuts it by roughly 70%,\n  which is why the image CDN in layer 2 is not a nice-to-have.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.42,
   "autoResize": false,
   "baseline": 10.0
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
